@model IEnumerable<EmployeeManagement.Web.Models.Employee>

@{
    ViewData["Title"] = "Employees";

    var departments = Model
        .Where(e => e.Department != null)
        .GroupBy(e => e.Department!)
        .Select(g => new
        {
            Department = g.Key,
            EmployeeCount = g.Count(),
            TotalSalary = g.Sum(e => e.Salary)
        })
        .ToList();
}

<h1>Employees</h1>


<!-- Employees Table -->
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Salary</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>
                    @employee.FirstName @employee.LastName
                </td>

                <td>
                    @employee.Email
                </td>

                <td>
                    @employee.Salary
                </td>

                <td>
                    @(employee.Department?.Name ?? "-")
                </td>

                <td>
                    <a asp-action="Details"
                       asp-route-id="@employee.Id">
                        Details
                    </a>

                    <span> | </span>

                    <a asp-action="Edit"
                       asp-route-id="@employee.Id">
                        Edit
                    </a>

                    <span> | </span>

                    <a asp-action="Delete"
                       asp-route-id="@employee.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>


<p>
    <a asp-action="Create">Create New</a>
</p>


<!-- Department Cards -->
<div style="
    display: flex;
    gap: 20px;
    margin-top: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;">

    @foreach (var item in departments)
    {
        <div style="
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 15px;
            width: 350px;
            box-shadow: 0 1px 3px rgba(0,0,0,.1);">

            <h3 style="margin-top: 0;">
                @item.Department.Name
            </h3>

            <p>
                @item.EmployeeCount employee(s)
            </p>

            <p>
                @item.TotalSalary $
            </p>

        </div>
    }

</div>


<!-- Search -->
<div style="
    margin-top: 20px;
    margin-bottom: 10px;">

    <input type="text"
           id="searchBox"
           placeholder="Search employees..."
           style="
    width: 100%;
    padding: 10px;
    box-sizing: border-box;" />

</div>


<!-- Search Results -->
<table class="table" id="resultsTable">

    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Salary</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody id="resultsBody">
    </tbody>

</table>


<script>

    const searchBox = document.getElementById("searchBox");

    const resultsBody = document.getElementById("resultsBody");


    searchBox.addEventListener("input", async function() {

        const term = this.value.trim();


        if (term === "") {

            resultsBody.innerHTML = "";

            return;
        }


        try {

            const response =
                await fetch(
                    `/Employees/Search?term=${encodeURIComponent(term)}`
                );


            if (!response.ok) {

                throw new Error("Search failed");

            }


            const employees = await response.json();


            renderResults(employees);

        }
        catch (error) {

            resultsBody.innerHTML = `
                    <tr>
                        <td colspan="6">
                            Error while searching
                        </td>
                    </tr>
                `;

        }

    });


    function renderResults(employees) {

        if (employees.length === 0) {

            resultsBody.innerHTML = `
                    <tr>
                        <td colspan="6">
                            No employees found
                        </td>
                    </tr>
                `;

            return;
        }


        resultsBody.innerHTML = employees.map(employee => {

            return `
                    <tr>

                        <td>
                            ${employee.id}
                        </td>

                        <td>
                            ${employee.firstName} ${employee.lastName}
                        </td>

                        <td>
                            ${employee.email}
                        </td>

                        <td>
                            ${employee.salary}
                        </td>

                        <td>
                            ${employee.departmentName}
                        </td>

                        <td>

                            <a href="/Employees/Details/${employee.id}">
                                Details
                            </a>

                            <span> | </span>

                            <a href="/Employees/Edit/${employee.id}">
                                Edit
                            </a>

                            <span> | </span>

                            <a href="/Employees/Delete/${employee.id}">
                                Delete
                            </a>

                        </td>

                    </tr>
                `;

        }).join("");

    }

</script>