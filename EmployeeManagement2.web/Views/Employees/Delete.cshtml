@model EmployeeManagement.Web.Models.Employee

<h1>Confirm Delete</h1>

<h3>Are you sure you want to delete this employee?</h3>

<div style="margin-top: 20px;">

    <p>
        <b>First Name:</b> @Model.FirstName
    </p>

    <p>
        <b>Last Name:</b> @Model.LastName
    </p>

    <p>
        <b>Email:</b> @Model.Email
    </p>

    <p>
        <b>Department:</b> @(Model.Department?.Name ?? "-")
    </p>

</div>

<form asp-action="Delete" method="post" style="margin-top: 25px;">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            style="background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 16px;
        cursor: pointer;">
        Yes, Delete
    </button>

    <a asp-action="Index" style="margin-left: 10px;">
        Cancel
    </a>

</form>